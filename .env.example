# Choose exactly one local model provider.
VISION_PROVIDER=ollama
VISION_MODEL=your-local-vision-model
RELATION_CONFIDENCE_THRESHOLD=0.7

# Ollama running on the host. Docker reaches the host through this name.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# For a local MLX or vLLM OpenAI-compatible server, use these instead:
# VISION_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:8001
# OPENAI_COMPATIBLE_MODEL=your-local-vision-model

# Browser-to-backend access for the Vite development server or Compose frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
